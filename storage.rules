rules_version = '2';

// Workout Crew Storage rules. Paste into Firebase console -> Storage -> Rules -> Publish.
// Requires the Blaze plan (Cloud Storage isn't available on Spark for new projects).

service firebase.storage {
  match /b/{bucket}/o {

    // Which crew the signed-in user belongs to (null if not a member of anyone's crew).
    function myCrewId() {
      return firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.crewId;
    }

    // You're in this crew once you have a members/{yourUid} document with a matching crewId.
    function isCrewMember(crewId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid))
        && myCrewId() == crewId;
    }

    // Chat photos: only the uploader can write to their own folder, images only, 8MB cap.
    match /chatImages/{crewId}/{uid}/{fileName} {
      allow read: if isCrewMember(crewId);
      allow write: if isCrewMember(crewId)
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Monthly progress photos: same shape as chat photos.
    match /progressPhotos/{crewId}/{uid}/{fileName} {
      allow read: if isCrewMember(crewId);
      allow write: if isCrewMember(crewId)
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Profile pictures: one file per person, replaceable any time.
    match /avatars/{crewId}/{uid}/{fileName} {
      allow read: if isCrewMember(crewId);
      allow write: if isCrewMember(crewId)
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isCrewMember(crewId) && request.auth.uid == uid;
    }
  }
}
