rules_version = '2';

// Workout Crew security rules. These ARE the backend: the website is public,
// so everything about who can read/write what is enforced here.
// Paste into Firebase console -> Firestore -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // You're in the crew once you have a members/{yourUid} document.
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function validCode(c) {
      return c is string && c.matches('^[A-Za-z0-9_-]{6,64}$');
    }

    function codeExists(c) {
      return exists(/databases/$(database)/documents/inviteCodes/$(c));
    }

    // ---------- invite codes (you create these in the console) ----------
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // ---------- members ----------
    function validNewMember(uid) {
      let d = request.resource.data;
      return signedIn()
        && request.auth.uid == uid
        && d.keys().hasOnly(['displayName', 'inviteCode', 'joinedAt'])
        && validName(d.displayName)
        && validCode(d.inviteCode)
        && codeExists(d.inviteCode)
        && d.joinedAt == request.time;
    }

    function validAvatarUrl(u) {
      return u is string && u.size() <= 500
        && u.matches('^https://firebasestorage[.]googleapis[.]com/.*');
    }

    function validProfileUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return signedIn()
        && request.auth.uid == uid
        && changed.hasOnly(['displayName', 'avatarUrl'])
        && (!changed.hasAny(['displayName']) || validName(d.displayName))
        && (!changed.hasAny(['avatarUrl']) || validAvatarUrl(d.avatarUrl));
    }

    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if validNewMember(uid);
      allow update: if validProfileUpdate(uid);
      allow delete: if false;
    }

    // ---------- workouts ----------
    function validDuration(x) {
      return x == null || (x is int && x >= 0 && x <= 1440);
    }

    function validNotes(x) {
      return x == null || (x is string && x.size() <= 1000);
    }

    function validRating(x) {
      return x == null || (x is int && x >= 1 && x <= 5);
    }

    function validWorkout(d) {
      let allowed = ['userId', 'performedOn', 'sortKey', 'type', 'durationMin', 'notes', 'rating', 'exercises', 'kudos', 'createdAt', 'updatedAt'];
      let required = ['userId', 'performedOn', 'sortKey', 'type', 'exercises', 'kudos', 'createdAt', 'updatedAt'];
      return d.keys().hasOnly(allowed)
        && d.keys().hasAll(required)
        && d.performedOn is string
        && d.performedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.sortKey is string
        && d.sortKey.size() <= 64
        && d.sortKey.split('_')[0] == d.performedOn
        && d.type is string
        && d.type.size() >= 1
        && d.type.size() <= 40
        && validDuration(d.get('durationMin', null))
        && validNotes(d.get('notes', null))
        && validRating(d.get('rating', null))
        && d.exercises is list
        && d.exercises.size() <= 50
        && d.kudos is list
        && d.kudos.size() <= 100
        && d.updatedAt == request.time;
    }

    function validNewWorkout() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && validWorkout(d)
        && d.kudos.size() == 0
        && d.createdAt == request.time;
    }

    // The owner edits their own workout's details.
    function validOwnerEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let editable = ['performedOn', 'sortKey', 'type', 'durationMin', 'notes', 'rating', 'exercises', 'updatedAt'];
      return resource.data.userId == request.auth.uid
        && changed.hasOnly(editable)
        && validWorkout(request.resource.data);
    }

    // Anyone in the crew adds or removes only THEIR OWN kudos.
    function validKudosChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.kudos.toSet();
      let after = request.resource.data.kudos;
      let me = [request.auth.uid];
      return changed.hasOnly(['kudos'])
        && after is list
        && after.size() <= 100
        && after.toSet().difference(before).hasOnly(me)
        && before.difference(after.toSet()).hasOnly(me);
    }

    match /workouts/{workoutId} {
      allow read: if isMember();
      allow create: if isMember() && validNewWorkout();
      allow update: if isMember() && (validOwnerEdit() || validKudosChange());
      allow delete: if isMember() && resource.data.userId == request.auth.uid;
    }

    // ---------- crew chat (one shared channel, permanent history) ----------
    function validImageUrl(d) {
      return !('imageUrl' in d) || (
        d.imageUrl is string && d.imageUrl.size() <= 500
        && d.imageUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*')
      );
    }

    function validMessage(d) {
      return d.keys().hasOnly(['userId', 'displayName', 'text', 'imageUrl', 'createdAt'])
        && d.keys().hasAll(['userId', 'displayName', 'text', 'createdAt'])
        && d.userId == request.auth.uid
        && validName(d.displayName)
        && d.text is string && d.text.size() <= 2000
        && (d.text.size() >= 1 || 'imageUrl' in d)
        && validImageUrl(d)
        && d.createdAt == request.time;
    }

    match /messages/{messageId} {
      allow read: if isMember();
      allow create: if isMember() && validMessage(request.resource.data);
      allow update, delete: if false;
    }

    // ---------- monthly weigh-ins (one per person per month, doc id = uid_YYYY-MM) ----------
    function validWeight(d) {
      return d.keys().hasOnly(['userId', 'month', 'weight', 'photoUrl', 'createdAt'])
        && d.keys().hasAll(['userId', 'month', 'weight', 'photoUrl', 'createdAt'])
        && d.userId == request.auth.uid
        && d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$')
        && d.weight is number && d.weight > 0 && d.weight <= 1000
        && d.photoUrl is string && d.photoUrl.size() <= 500
        && d.photoUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*')
        && d.createdAt == request.time;
    }

    match /weights/{weightId} {
      allow read: if isMember();
      allow create: if isMember()
        && validWeight(request.resource.data)
        && weightId == request.resource.data.userId + '_' + request.resource.data.month;
      allow update, delete: if false;
    }
  }
}
