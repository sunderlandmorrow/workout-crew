rules_version = '2';

// Workout Crew security rules. These ARE the backend: the website is public,
// so everything about who can read/write what is enforced here.
// Paste into Firebase console -> Firestore -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // You're in the crew once you have a members/{yourUid} document.
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function validCode(c) {
      return c is string && c.matches('^[A-Za-z0-9_-]{6,64}$');
    }

    function codeExists(c) {
      return exists(/databases/$(database)/documents/inviteCodes/$(c));
    }

    // ---------- invite codes (you create these in the console) ----------
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // ---------- members ----------
    function validNewMember(uid) {
      let d = request.resource.data;
      return signedIn()
        && request.auth.uid == uid
        && d.keys().hasOnly(['displayName', 'inviteCode', 'joinedAt'])
        && validName(d.displayName)
        && validCode(d.inviteCode)
        && codeExists(d.inviteCode)
        && d.joinedAt == request.time;
    }

    function validRename(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && request.auth.uid == uid
        && changed.hasOnly(['displayName'])
        && validName(request.resource.data.displayName);
    }

    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if validNewMember(uid);
      allow update: if validRename(uid);
      allow delete: if false;
    }

    // ---------- workouts ----------
    function validDuration(x) {
      return x == null || (x is int && x >= 0 && x <= 1440);
    }

    function validNotes(x) {
      return x == null || (x is string && x.size() <= 1000);
    }

    function validWorkout(d) {
      let allowed = ['userId', 'performedOn', 'sortKey', 'type', 'durationMin', 'notes', 'exercises', 'kudos', 'createdAt', 'updatedAt'];
      let required = ['userId', 'performedOn', 'sortKey', 'type', 'exercises', 'kudos', 'createdAt', 'updatedAt'];
      return d.keys().hasOnly(allowed)
        && d.keys().hasAll(required)
        && d.performedOn is string
        && d.performedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.sortKey is string
        && d.sortKey.size() <= 64
        && d.sortKey.split('_')[0] == d.performedOn
        && d.type is string
        && d.type.size() >= 1
        && d.type.size() <= 40
        && validDuration(d.get('durationMin', null))
        && validNotes(d.get('notes', null))
        && d.exercises is list
        && d.exercises.size() <= 50
        && d.kudos is list
        && d.kudos.size() <= 100
        && d.updatedAt == request.time;
    }

    function validNewWorkout() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && validWorkout(d)
        && d.kudos.size() == 0
        && d.createdAt == request.time;
    }

    // The owner edits their own workout's details.
    function validOwnerEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let editable = ['performedOn', 'sortKey', 'type', 'durationMin', 'notes', 'exercises', 'updatedAt'];
      return resource.data.userId == request.auth.uid
        && changed.hasOnly(editable)
        && validWorkout(request.resource.data);
    }

    // Anyone in the crew adds or removes only THEIR OWN kudos.
    function validKudosChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.kudos.toSet();
      let after = request.resource.data.kudos;
      let me = [request.auth.uid];
      return changed.hasOnly(['kudos'])
        && after is list
        && after.size() <= 100
        && after.toSet().difference(before).hasOnly(me)
        && before.difference(after.toSet()).hasOnly(me);
    }

    match /workouts/{workoutId} {
      allow read: if isMember();
      allow create: if isMember() && validNewWorkout();
      allow update: if isMember() && (validOwnerEdit() || validKudosChange());
      allow delete: if isMember() && resource.data.userId == request.auth.uid;
    }
  }
}
